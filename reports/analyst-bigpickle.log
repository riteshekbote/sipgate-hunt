import { spawn } from 'node:child_process';

const chrome = spawn('/usr/bin/chromium', [
  '--headless=new','--no-sandbox','--disable-gpu','--disable-dev-shm-usage',
  '--remote-debugging-port=9222','--user-data-dir=/tmp/opencode/coc/cdp-prof','about:blank'
], { stdio: 'ignore' });

const sleep = (ms) => new Promise(r => setTimeout(r, ms));

async function getJson(url, tries = 30) {
  for (let i = 0; i < tries; i++) {
    try { const r = await fetch(url); if (r.ok) return await r.json(); } catch {}
    await sleep(500);
  }
  throw new Error('CDP not up');
}

class Ctx {
  constructor(ws){ this.ws = ws; this.id = 0; this.pending = new Map(); this.events = [];
    ws.onmessage = (m) => { const d = JSON.parse(m.data); if (d.id) { const p = this.pending.get(d.id); if (p) { this.pending.delete(d.id); d.error ? p.reject(new Error(JSON.stringify(d.error))) : p.resolve(d.result); } } }; }
  send(method, params = {}) { const id = ++this.id; this.ws.send(JSON.stringify({id, method, params})); return new Promise((resolve,reject) => this.pending.set(id, {resolve,reject})); }
  async eval(expr) { const r = await this.send('Runtime.evaluate', { expression: expr, awaitPromise: true, returnByValue: true }); if (r.exceptionDetails) return 'EXCEPTION: ' + JSON.stringify(r.exceptionDetails.exception?.description || r.exceptionDetails.text); return JSON.stringify(r.result?.result?.value); }
}

async function main() {
  const tabs = await getJson('http://127.0.0.1:9222/json');
  const page = tabs.find(t => t.type === 'page');
  const evil = new Ctx(new WebSocket(page.webSocketDebuggerUrl));
  await evil.send('Page.enable');
  await evil.send('Runtime.enable');
  await evil.send('Page.navigate', { url: 'http://127.0.0.1:12345/evil.html' });
  await sleep(4000);

  const delivered = await evil.eval('document.body.getAttribute("data-result")');
  const finalMsg = await evil.eval('window.__result');

  // also open the popup as a separate target and inspect the victim page directly
  const victims = (await getJson('http://127.0.0.1:9222/json')).filter(t => t.url.includes('victim.html'));
  let victimInfo = [];
  for (const v of victims) {
    const vc = new Ctx(new WebSocket(v.webSocketDebuggerUrl));
    const title = await vc.eval('document.title');
    victimInfo.push(title);
  }
  console.log('EVIL__result       :', finalMsg);
  console.log('EVIL data-result   :', delivered);
  console.log('VICTIM titles      :', JSON.stringify(victimInfo));
  console.log('VERDICT            :', delivered === 'DELIVERED' || (finalMsg||'').startsWith('DELIVERED') ? 'TOKEN_DELIVERED_CROSS_ORIGIN' : 'BLOCKED_CROSS_ORIGIN');
  process.exit(0);
}

main().catch(e => { console.error('ERR', e.message); process.exit(1); });
EOF
