import json, re
data = open('/tmp/opencode/swagger-ui-init.js').read()
start = data.index('\"swaggerDoc\":') + len('\"swaggerDoc\":')
# find the matching closing brace by brace counting
depth = 0; i = start
while i < len(data):
    c = data[i]
    if c == '{': depth += 1
    elif c == '}':
        depth -= 1
        if depth == 0:
            doc = json.loads(data[start:i+1]); break
    i += 1
for path, methods in doc['paths'].items():
    for method, op in methods.items():
        sec = op.get('security', 'NO-SEC')
        print(f'{method.upper():6} {path:40} sec={sec} op={op.get(\"operationId\")}'.replace('\n',' '))
